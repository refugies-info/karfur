{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies"],
  "ignoreDependencies": ["@refugies-info/api-types"],
  "workspaces": {
    "apps/client": {
      "entry": ["src/scripts/*.js"],
      "ignoreDependencies": [
        "@tailwindcss/typography",
        "bootstrap",
        "cssnano",
        "eslint-config-next",
        "eslint-config-turbo",
        "flag-icons",
        "react-anchor-link-smooth-scroll",
        "remixicon",
        "sharp",
        "tailwindcss",
        "typescript-plugin-css-modules"
      ]
    },
    "apps/mobile": {
      "entry": ["build-scripts/*.js", "src/translations/scripts/*.js", "src/utils/*.js"],
      "ignoreDependencies": [
        "@babel/preset-env",
        "@babel/runtime",
        "@react-native/assets-registry",
        "@types/styled-components-react-native",
        "use-sync-external-store"
      ]
    },
    "apps/server": {
      "entry": ["src/server.ts"],
      "ignoreDependencies": [
        "@tsoa/runtime",
        "eslint-config-turbo",
        "nodemon",
        "path-to-regexp",
        "ts-node",
        "tsconfig-paths"
      ]
    },
    "packages/api-types": {
      "ignoreDependencies": ["eslint-config-turbo", "globals"]
    },
    "apps/storybook": {
      "ignoreDependencies": [
        "@storybook/blocks",
        "@tailwindcss/typography",
        "eslint-config-next",
        "eslint-config-turbo",
        "eslint-plugin-storybook",
        "globals",
        "tailwindcss"
      ]
    },
    "packages/ui": {
      "ignoreDependencies": ["eslint-config-turbo", "tailwindcss"]
    }
  }
}
