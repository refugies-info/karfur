{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies"],
  "workspaces": {
    "apps/client": {
      "entry": ["src/locales/interfaceTranslation/*.js"],
      "ignoreDependencies": [
        "@refugies-info/ui",
        "flag-icons",
        "postcss",
        "react-anchor-link-smooth-scroll",
        "remixicon",
        "sharp",
        "tailwindcss",
        "typescript-plugin-css-modules",
        "bootstrap"
      ]
    },
    "apps/mobile": {
      "entry": ["build-scripts/*.js", "src/translations/scripts/*.js", "src/utils/*.js"],
      "ignoreDependencies": [
        "@babel/preset-env",
        "@babel/runtime",
        "@react-native/assets-registry",
        "@types/styled-components-react-native",
        "react-native-webview",
        "use-sync-external-store"
      ]
    },
    "apps/server": {
      "entry": ["src/server.ts"],
      "ignoreDependencies": [
        "@tsoa/runtime",
        "nodemon",
        "path-to-regexp",
        "tsconfig-paths",
        "ts-node",
        "@types/mongoose"
      ]
    },
    "apps/storybook": {
      "ignoreDependencies": ["@storybook/blocks", "postcss", "tailwindcss"]
    },
    "packages/ui": {
      "ignoreDependencies": ["@tailwindcss/postcss", "react-dom", "prettier", "prettier-plugin-tailwindcss"]
    }
  }
}
