{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.js", "postcss.config.mjs", "tailwind.config.ts", "migrations/**/*.ts"],
      "ignoreDependencies": ["turbo"]
    },
    "apps/client": {
      "entry": ["next-sitemap.config.js", "scripts/*.js"],
      "ignoreDependencies": [
        "@tailwindcss/typography",
        "bootstrap",
        "cssnano",
        "flag-icons",
        "react-anchor-link-smooth-scroll",
        "remixicon",
        "sharp",
        "tailwindcss",
        "typescript-plugin-css-modules"
      ]
    },
    "apps/mobile": {
      "entry": ["build-scripts/*.js", "src/translations/scripts/*.js", "src/utils/*.js"],
      "expo": false,
      "ignoreDependencies": [
        "@babel/preset-env",
        "@babel/runtime",
        "@react-native-community/netinfo",
        "@react-native/assets-registry",
        "@redux-devtools/extension",
        "@types/styled-components-react-native",
        "@welldone-software/why-did-you-render",
        "expo-build-properties",
        "expo-dev-client",
        "expo-font",
        "expo-status-bar",
        "expo-system-ui",
        "papaparse",
        "react-native-reanimated-carousel",
        "react-native-svg-transformer",
        "use-sync-external-store"
      ]
    },
    "apps/server": {
      "entry": ["src/server.ts", "src/authentication.ts"],
      "ignoreDependencies": [
        "@google-cloud/translate",
        "@tsoa/runtime",
        "@types/uniqid",
        "axios",
        "googleapis",
        "microsoft-cognitiveservices-speech-sdk",
        "node-cache",
        "path-to-regexp",
        "ts-node",
        "tsconfig-paths",
        "uniqid"
      ],
      "ignore": ["dist/**"]
    },
    "packages/api-types": {
      "ignoreDependencies": []
    },
    "apps/storybook": {
      "ignoreDependencies": ["@tailwindcss/typography", "tailwindcss"]
    },
    "packages/ui": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
