{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["dependencies"],
  "workspaces": {
    "apps/client": {
      "entry": [
        "src/locales/interfaceTranslation/*.js"
      ],
      "ignoreDependencies": [
        "postcss",
        "sharp"
      ]
    },
    "apps/mobile": {
      "entry": [
        "src/translations/scripts/*.js"
      ],
      "ignoreDependencies": [
        "@babel/preset-env",
        "@babel/runtime",
        "@types/styled-components-react-native"
      ]
    },
    "apps/server": {
      "entry": [
        "src/server.ts"
      ],
      "ignoreDependencies": [
        "@types/*",
        "nodemon",
        "tsconfig-paths"
      ]
    },
    "apps/storybook": {
      "ignoreDependencies": [
        "@storybook/blocks",
        "postcss",
        "tailwindcss"
      ]
    },
    "packages/ui": {
      "ignoreDependencies": [
        "@tailwindcss/postcss",
        "react-dom"
      ]
    }
  }
}
