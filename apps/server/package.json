{
  "name": "@refugies-info/server",
  "version": "0.1.0",
  "description": "Plateforme dédiée aux réfugiés",
  "author": "Soufiane Lamrissi",
  "homepage": "https://refugies.info",
  "copyright": "Copyright 2019 DiAiR",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "build": "pnpm gen:tsoa && ncc build src/server.ts -o dist",
    "build:dev": "pnpm gen:tsoa && tsc",
    "check:types": "pnpm gen:tsoa && tsc --noEmit",
    "dev": "pnpm build:dev && concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
    "gen:tsoa": "tsoa spec-and-routes",
    "lint": "eslint . --ext ts,tsx,js --quiet --cache",
    "lint:fix": "eslint --fix",
    "pr:prod": "gh pr create -B master-backend -H staging-backend -l release -t '[PROD-BACK] Release' -b ''",
    "pr:stg": "gh pr create -B staging-backend -H dev -l release -t '[STG-BACK] Release' -b ''",
    "start": "node dist/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.1",
    "@getbrevo/brevo": "^2.2.0",
    "@google-cloud/translate": "^8.5.1",
    "@refugies-info/api-types": "workspace:*",
    "@sendgrid/mail": "^8.1.4",
    "@slack/webhook": "^7.0.5",
    "@typegoose/typegoose": "^12.17.0",
    "airtable": "^0.12.2",
    "algoliasearch": "^5.29.0",
    "axios": "^1.10.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.12.0",
    "express": "^4.21.2",
    "express-form-data": "^2.0.18",
    "google-auth-library": "^9.15.0",
    "jwt-simple": "^0.5.5",
    "lodash": "^4.17.21",
    "microsoft-cognitiveservices-speech-sdk": "^1.44.1",
    "moment": "^2.29.4",
    "mongoose": "^8.16.3",
    "node-cache": "^5.1.2",
    "password-hash": "^1.2.2",
    "path-to-regexp": ">=0.1.12",
    "phone": "^3.1.62",
    "ts-node": "^10.9.2",
    "tsoa": "^6.6.0",
    "twilio": "^5.7.1",
    "uniqid": "^5.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@refugies-info/typescript-config": "workspace:*",
    "@tsoa/runtime": "^6.5.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-form-data": "^2.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.19",
    "@types/node": "^22.15.33",
    "@types/password-hash": "^1.2.20",
    "@types/uniqid": "^5.3.0",
    "@vercel/ncc": "^0.38.3",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-config-turbo": "2.5.4",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "engines": {
    "node": "22.14.0"
  },
  "volta": {
    "node": "22.14.0",
    "pnpm": "10.12.3"
  }
}
