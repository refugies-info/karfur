{
  "name": "@refugies-info/server",
  "version": "0.1.0",
  "description": "Plateforme dédiée aux réfugiés",
  "author": "Soufiane Lamrissi",
  "homepage": "https://refugies.info",
  "copyright": "Copyright 2019 DiAiR",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "build": "yarn gen:tsoa && ncc build src/server.ts -o dist",
    "build:dev": "yarn gen:tsoa && tsc",
    "check:types": "yarn gen:tsoa && tsc --noEmit",
    "dev": "yarn build:dev && concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
    "gen:tsoa": "tsoa spec-and-routes",
    "lint": "eslint . --ext ts,tsx,js --quiet --cache",
    "lint:fix": "eslint --fix",
    "pr:prod": "gh pr create -B master-backend -H staging-backend -l release -t '[PROD-BACK] Release' -b ''",
    "pr:stg": "gh pr create -B staging-backend -H dev -l release -t '[STG-BACK] Release' -b ''",
    "start": "node dist/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.1",
    "@google-cloud/translate": "^8.5.0",
    "@refugies-info/api-types": "*",
    "@sendgrid/mail": "^8.1.4",
    "@sendinblue/client": "^3.2.2",
    "@slack/webhook": "^7.0.1",
    "@typegoose/typegoose": "^12.9.0",
    "airtable": "^0.12.2",
    "algoliasearch": "^5.14.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.12.0",
    "express": "^4.21.1",
    "express-form-data": "^2.0.18",
    "google-auth-library": "^9.15.0",
    "jwt-simple": "^0.5.5",
    "lodash": "^4.17.21",
    "microsoft-cognitiveservices-speech-sdk": "^1.41.0",
    "moment": "^2.29.4",
    "mongodb": "^6.10.0",
    "mongoose": "8.8.1",
    "node-cache": "^5.1.2",
    "password-hash": "^1.2.2",
    "ts-node": "^10.9.2",
    "tsoa": "^6.6.0",
    "twilio": "^5.3.6",
    "uniqid": "^5.0.3",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@refugies-info/typescript-config": "*",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.0",
    "@types/express-form-data": "^2.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/mongoose": "^5.10.1",
    "@types/node": "^22.9.0",
    "@types/password-hash": "^1.2.20",
    "@types/uniqid": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vercel/ncc": "^0.38.3",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-turbo": "^2.3.0",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.2.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "20.13.1",
    "yarn": "1.22.22"
  },
  "volta": {
    "node": "20.13.1",
    "yarn": "1.22.22"
  }
}
