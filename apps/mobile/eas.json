{
  "build": {
    "base": {
      "channel": "base",
      "ios": {
        "image": "latest"
      },
      "node": "24.13.0",
      "pnpm": "10.28.0"
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    },
    "staging": {
      "extends": "base",
      "channel": "staging",
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_APP_NAME": "Réfugiés.info - Staging",
        "EAS_BUILD_PROFILE": "staging"
      }
    },
    "staging-simulator": {
      "extends": "staging",
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "channel": "staging",
      "distribution": "internal",
      "env": {
        "EXPO_APP_NAME": "Réfugiés.info - Dev",
        "EAS_BUILD_PROFILE": "staging"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_APP_NAME": "Réfugiés.info - Preview",
        "EAS_BUILD_PROFILE": "preview"
      }
    }
  },
  "cli": {
    "version": ">= 0.35.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../credentials/refugies-info-appkey.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "nourallazkani@gmail.com",
        "ascAppId": "1595597429",
        "appleTeamId": "98K762J2MM"
      }
    }
  }
}
