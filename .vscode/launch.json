{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/client"
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev --filter @refugies-info/server --filter @refugies-info/client --filter @refugies-info/ui"
    },
    {
      "name": "Debug server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:server",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Test (client)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["test:client", "--runInBand", "--detectOpenHandles", "${fileBasename}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Test (mobile)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["test:mobile", "--runInBand", "--detectOpenHandles", "${fileBasename}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Test (server)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["test:server", "--runInBand", "--detectOpenHandles", "${fileBasename}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    }
  ]
}
