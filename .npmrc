# =============================================================================
# pnpm Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Compatibility
# -----------------------------------------------------------------------------

# Use traditional flat node_modules structure (npm-style) instead of pnpm's
# default symlinked approach. Required for compatibility with some tools.
node-linker = hoisted

# Automatically install peer dependencies to avoid manual resolution.
auto-install-peers = true

# Fail installation if peer dependency requirements cannot be satisfied.
# Catches version mismatches early rather than at runtime.
strict-peer-dependencies = true

# -----------------------------------------------------------------------------
# Performance
# -----------------------------------------------------------------------------

# Cache the results of packages with postinstall scripts for faster reinstalls.
side-effects-cache = true

# -----------------------------------------------------------------------------
# Supply Chain Security
# -----------------------------------------------------------------------------

# Verify SHA-512 checksums of cached packages against the lockfile.
# Detects tampering if a package in the store was modified post-download.
verify-store-integrity = true

# Prevent install scripts from running with root/elevated privileges.
# Limits blast radius if a malicious postinstall script executes.
unsafe-perm = false

# Resolve to the latest version available at lockfile creation time.
# Ensures reproducible installs and prevents dependency confusion attacks.
resolution-mode = time-based
