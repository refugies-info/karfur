{
  "extends": "@refugies-info/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "skipLibCheck": true,
    "types": ["react/canary"]
  },
  "include": ["src", "src/types"],
  "exclude": ["node_modules", "dist", "build"]
}
