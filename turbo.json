{
  "$schema": "https://v2-8-16.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["NODE_ENV"],
  "tasks": {
    "//#base": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.gemini/**", "!**/.specify/**", "!**/.windsurf/**"]
    },
    "//#update-icons": {
      "cache": false,
      "outputs": ["node_modules/@codegouvfr/react-dsfr/dist/utility/icons/icons.css"],
      "dependsOn": ["//#base"]
    },
    "@refugies-info/ui#build": {
      "dependsOn": ["//#base"],
      "outputs": ["dist/**"]
    },
    "@refugies-info/storybook#build": {
      "dependsOn": ["^build", "//#base"],
      "outputs": ["storybook-static/**"]
    },
    "@refugies-info/client#build": {
      "dependsOn": ["//#update-icons", "@refugies-info/ui#build"],
      "env": ["NEXT_PUBLIC_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        "!**/.gemini/**",
        "!**/.specify/**",
        "!**/.windsurf/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@refugies-info/server#build": {
      "dependsOn": [],
      "env": [
        "accountSid",
        "AIRTABLE_BASE_CONTENU",
        "AIRTABLE_BASE_TRAD",
        "AIRTABLE_BASE_USERS",
        "AIRTABLE_TOKEN",
        "ALGOLIA_API_KEY",
        "ALGOLIA_INDEX",
        "API_KEY",
        "API_SECRET",
        "authToken",
        "BREVO_API_KEY",
        "CLOUD_NAME",
        "CRON_TOKEN",
        "EXPO_ACCESS_TOKEN",
        "FRONT_SITE_URL",
        "GCLOUD_CLIENT_EMAIL",
        "GCLOUD_CLIENT_ID",
        "GCLOUD_CLIENT_X509",
        "GCLOUD_PKEY",
        "GCLOUD_PRIVATE_KEY_ID",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "MINIMUM_APP_VERSION",
        "MONGODB_URI",
        "NODE_ENV",
        "PORT",
        "POSTMAN_SECRET",
        "REACT_APP_SITE_SECRET",
        "SECRET",
        "SENDGRID_API_KEY",
        "SLACK_WEBHOOK_URL",
        "SMS_SENDER",
        "TTS_KEY_1"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        "!**/.gemini/**",
        "!**/.specify/**",
        "!**/.windsurf/**"
      ],
      "outputs": ["dist/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types", "//#base"]
    },
    "@refugies-info/client#dev": {
      "dependsOn": ["//#update-icons"],
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env", "!**/.gemini/**", "!**/.specify/**", "!**/.windsurf/**"]
    },
    "@refugies-info/storybook#dev": {
      "dependsOn": ["//#update-icons"],
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env", "!**/.gemini/**", "!**/.specify/**", "!**/.windsurf/**"]
    },
    "@refugies-info/ui#dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env", "!**/.gemini/**", "!**/.specify/**", "!**/.windsurf/**"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["@refugies-info/ui#build", "^test", "//#base"]
    },
    "lint": {
      "dependsOn": ["^lint", "//#base"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix", "//#base"]
    },
    "format": {
      "dependsOn": ["^format", "//#base"]
    },
    "e2e": {
      "cache": false,
      "outputs": ["test-results/**", "screenshots/**"]
    }
  }
}
